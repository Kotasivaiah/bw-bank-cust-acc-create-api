#%RAML 1.0 DataType
properties:
  accountNumber:
    type: string
    minLength: 10
    maxLength: 10
  atmPin:
    type: string
    minLength: 4
    maxLength: 4
  ifscCode:
    type: string
    minLength: 4
    maxLength: 10
  depositAmount:
    type: number
  mailId:
    type: string
  contact:
    type: integer