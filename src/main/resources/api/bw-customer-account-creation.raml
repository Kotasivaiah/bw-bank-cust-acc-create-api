#%RAML 1.0
title: bw-customer-account-creation
description: API for bank customer account creation 
version: 1.0
protocols:
  - HTTP
  - HTTPS
securitySchemes:
  securekey: !include /SecurityScheme/securityScheme.raml
securedBy:
  - securekey
/createAccount:
  post:
    queryParameters:
      customerName:
        required: true
        minLength: 4
        maxLength: 45
      bank:
        required: true
        enum: [HDFC, ICICI, AXIS]
      type:
        required: true
        enum: [Savings, Current]
      BranchName:
        required: true
        minLength: 4
        maxLength: 10
    body:
      application/json:
        type: !include /dataTypes/inputDataTypes.raml
        example: !include /example/request/inputRequestExample.raml
    responses:
      200:
        body:
          application/json:
            example: !include /example/response/successResponse.raml
              
        